# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic (confidence scoring) ---
ANTHROPIC_API_KEY=

# --- MT5 ---
# Two separate credential sets so MT5_MODE switches which one logs in.
MT5_LOGIN_DEMO=
MT5_PASSWORD_DEMO=
MT5_SERVER_DEMO=
MT5_LOGIN_LIVE=
MT5_PASSWORD_LIVE=
MT5_SERVER_LIVE=

# demo | live — which credential set the live engine logs into.
MT5_MODE=demo
# Second, independent guard. Must ALSO be true (in addition to MT5_MODE=live)
# before any live MT5 order is placed. A single misconfigured var can't
# accidentally trade the real account.
ALLOW_LIVE_TRADING=false

# --- Binance ---
BINANCE_API_KEY_TESTNET=
BINANCE_API_SECRET_TESTNET=
BINANCE_API_KEY_LIVE=
BINANCE_API_SECRET_LIVE=

# testnet | live
BINANCE_MODE=testnet
ALLOW_LIVE_BINANCE_TRADING=false

# Your Binance referral link, shown on the site for P2P onboarding.
BINANCE_REFERRAL_LINK=

# --- Strategy ---
CONFIDENCE_THRESHOLD=73

# Which tracks the engine polls. Unset = all four (both brokers, both
# cadences). Comma-separated "broker:name" entries; an unknown name is a
# startup error, not a silent no-op. MT5 tracks are dropped automatically on
# hosts without MetaTrader5 regardless of this setting.
#   binance:scalp_day       H4 bias / M15 entries, polled every 60s
#   binance:swing_position  D1 bias / H4 entries, polled every 900s
# If you check for signals manually every few hours, note that an M15 signal
# is stale long before you see it -- swing_position matches that cadence.
TRACKS_ENABLED=

# Per-track hourly ceiling on Claude confidence calls -- a runaway-loop guard,
# not a budget cap. Rough per-call cost at 25 candles: ~$0.005 on Sonnet,
# ~$0.0125 on Opus. At the default 10/hr with two tracks running, worst case is
# ~480 calls/day (~$2.40-6.00/day). Size this against your API credit: a fixed
# $5 credit can still be spent in a couple of saturated days, so lower it
# further while forward-testing on a small credit.
MAX_CONFIDENCE_CALLS_PER_HOUR=10

# --- Database ---
# Supabase Postgres connection string (Project Settings -> Database ->
# Connection string -> URI). Leave unset to keep using local SQLite at
# FKB_DB_PATH instead -- useful before Supabase is wired up.
DATABASE_URL=
FKB_DB_PATH=./data/fkb.db

# --- Webapp ---
# The webapp reads and writes trading data and has several unauthenticated-by-
# default write endpoints, so it refuses to start without a password. Set
# FKB_ALLOW_NO_AUTH=true instead only for a localhost-only run.
FKB_PASSWORD=
FKB_ALLOW_NO_AUTH=false

# Signs the session cookie. Must be stable or every restart logs you out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FKB_SECRET_KEY=

# The session cookie is HTTPS-only by default. Set true ONLY to test over
# plain http on localhost -- never on a public host, where it would send your
# session in clear.
FKB_COOKIE_INSECURE=false

FKB_SCREENSHOTS_DIR=./data/screenshots
